{
  "name": "Transactional_Fraud_Detection_SemanticModel",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Fact_Transactions",
        "columns": [
          {
            "name": "Transaction_ID",
            "dataType": "string",
            "sourceColumn": "Transaction_ID"
          },
          {
            "name": "Time",
            "dataType": "double",
            "sourceColumn": "Time"
          },
          {
            "name": "Elapsed_Hours",
            "dataType": "double",
            "sourceColumn": "Elapsed_Hours"
          },
          {
            "name": "Hour_Of_Day",
            "dataType": "int64",
            "sourceColumn": "Hour_Of_Day"
          },
          {
            "name": "Day_Window",
            "dataType": "string",
            "sourceColumn": "Day_Window"
          },
          {
            "name": "Time_Bucket",
            "dataType": "string",
            "sourceColumn": "Time_Bucket"
          },
          {
            "name": "Amount",
            "dataType": "double",
            "sourceColumn": "Amount",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Amount_Band",
            "dataType": "string",
            "sourceColumn": "Amount_Band"
          },
          {
            "name": "Class",
            "dataType": "int64",
            "sourceColumn": "Class"
          },
          {
            "name": "Fraud_Status",
            "dataType": "string",
            "sourceColumn": "Fraud_Status"
          },
          {
            "name": "Risk_Score",
            "dataType": "double",
            "sourceColumn": "Risk_Score",
            "formatString": "0.0000"
          },
          {
            "name": "Risk_Tier",
            "dataType": "string",
            "sourceColumn": "Risk_Tier"
          },
          {
            "name": "Predicted_Fraud",
            "dataType": "int64",
            "sourceColumn": "Predicted_Fraud"
          },
          {
            "name": "V1",
            "dataType": "double",
            "sourceColumn": "V1"
          },
          {
            "name": "V2",
            "dataType": "double",
            "sourceColumn": "V2"
          },
          {
            "name": "V3",
            "dataType": "double",
            "sourceColumn": "V3"
          },
          {
            "name": "V4",
            "dataType": "double",
            "sourceColumn": "V4"
          },
          {
            "name": "V10",
            "dataType": "double",
            "sourceColumn": "V10"
          },
          {
            "name": "V11",
            "dataType": "double",
            "sourceColumn": "V11"
          },
          {
            "name": "V12",
            "dataType": "double",
            "sourceColumn": "V12"
          },
          {
            "name": "V14",
            "dataType": "double",
            "sourceColumn": "V14"
          },
          {
            "name": "V16",
            "dataType": "double",
            "sourceColumn": "V16"
          },
          {
            "name": "V17",
            "dataType": "double",
            "sourceColumn": "V17"
          }
        ],
        "partitions": [
          {
            "name": "Fact_Transactions-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"C:/Users/Aditya/Downloads/Infyntrex internship/Transactional Fraud Detection Analysis/PowerBI/data/Fact_Transactions_Analytical.csv\"), [Delimiter=\",\", Columns=41, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{",
                "        {\"Transaction_ID\", type text}, {\"Time\", type number}, {\"Elapsed_Hours\", type number},",
                "        {\"Hour_Of_Day\", Int64.Type}, {\"Day_Window\", type text}, {\"Time_Bucket\", type text},",
                "        {\"Amount\", type number}, {\"Amount_Band\", type text}, {\"Class\", Int64.Type},",
                "        {\"Fraud_Status\", type text}, {\"Risk_Score\", type number}, {\"Risk_Tier\", type text},",
                "        {\"Predicted_Fraud\", Int64.Type}, {\"V14\", type number}, {\"V17\", type number}, {\"V12\", type number}",
                "    })",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Transactions",
            "expression": "COUNTROWS(Fact_Transactions)"
          },
          {
            "name": "Fraud Transactions",
            "expression": "CALCULATE(COUNTROWS(Fact_Transactions), Fact_Transactions[Class] = 1)"
          },
          {
            "name": "Legitimate Transactions",
            "expression": "CALCULATE(COUNTROWS(Fact_Transactions), Fact_Transactions[Class] = 0)"
          },
          {
            "name": "Fraud Rate %",
            "expression": "DIVIDE([Fraud Transactions], [Total Transactions], 0) * 100",
            "formatString": "0.000%"
          },
          {
            "name": "Total Volume USD",
            "expression": "SUM(Fact_Transactions[Amount])",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Fraud Loss USD",
            "expression": "CALCULATE(SUM(Fact_Transactions[Amount]), Fact_Transactions[Class] = 1)",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Avg Transaction Amount",
            "expression": "AVERAGE(Fact_Transactions[Amount])",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Avg Fraud Amount",
            "expression": "CALCULATE(AVERAGE(Fact_Transactions[Amount]), Fact_Transactions[Class] = 1)",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Avg Legit Amount",
            "expression": "CALCULATE(AVERAGE(Fact_Transactions[Amount]), Fact_Transactions[Class] = 0)",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Nighttime Fraud Count",
            "expression": "CALCULATE([Fraud Transactions], Fact_Transactions[Hour_Of_Day] >= 0 && Fact_Transactions[Hour_Of_Day] <= 5)"
          },
          {
            "name": "Nighttime Fraud Rate %",
            "expression": "DIVIDE([Nighttime Fraud Count], CALCULATE([Total Transactions], Fact_Transactions[Hour_Of_Day] >= 0 && Fact_Transactions[Hour_Of_Day] <= 5), 0) * 100",
            "formatString": "0.000%"
          },
          {
            "name": "RF Fraud Catch Rate %",
            "expression": "81.63",
            "formatString": "0.00%"
          },
          {
            "name": "RF Precision %",
            "expression": "75.47",
            "formatString": "0.00%"
          },
          {
            "name": "False Alarm Reduction %",
            "expression": "98.26",
            "formatString": "0.00%"
          },
          {
            "name": "Prevented Fraud Loss USD",
            "expression": "[Fraud Loss USD] * 0.8163",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Net Economic Value Delivered USD",
            "expression": "[Prevented Fraud Loss USD] + 73300",
            "formatString": "$#,##0.00"
          }
        ]
      },
      {
        "name": "Dim_Time_Analysis",
        "columns": [
          {
            "name": "Hour_Of_Day",
            "dataType": "int64",
            "sourceColumn": "Hour_Of_Day"
